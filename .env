# ============================================================================
# Docker Compose 环境变量配置
# ============================================================================

# ============================================================================
# Litisle 项目 - Docker Compose 环境变量配置
# ============================================================================

# -------------------------
# MySQL 业务数据库配置
# 注意：MYSQL_DATABASE 仅用于创建 MySQL 默认数据库（实际未使用）
# 真实业务数据库（litisle_user / litisle_content / ...）由 init 脚本创建
# 详见 docker/init/mysql/00-init-databases.sql
# -------------------------
MYSQL_ROOT_PASSWORD=verysecret
MYSQL_DATABASE=litisle_db
MYSQL_USER=test_k.1
COMPOSE_MYSQL_PASSWORD=123

# -------------------------
# Redis 缓存配置
# -------------------------
# COMPOSE_REDIS_PASSWORD=123


# -------------------------
# 以下是旧项目（Microservices-Demo）的变量，已弃用，留作参考
# -------------------------
# MYSQL_ROOT_PASSWORD=verysecret
# MYSQL_DATABASE=microservices_demo_user
# MYSQL_USER=test_k.1
# COMPOSE_MYSQL_PASSWORD=123

# Nacos 专用数据库配置
NACOS_MYSQL_ROOT_PASSWORD=nacos_root
NACOS_MYSQL_PASSWORD=nacos_pass

# Nacos 服务连接 MySQL 的专用账号（最小权限：仅 nacos_config 库，含 DDL——3.x 启动时迁移器需要建表）
# 账号由 docker/init/mysql/20-nacos-user.sql 创建（存量环境需手动执行一次，见该文件头部注释）
NACOS_DB_USER=nacos
NACOS_DB_PASSWORD=nacos_pass

# Seata TC Server 专用数据库账号（最小权限：仅 seata_server 库）
# 账号由 docker/init/mysql/00-init-databases.sql 创建，密码需与该文件中硬编码值一致
SEATA_DB_USER=seata
SEATA_DB_PASSWORD=seata_pass

# Redis 密码
COMPOSE_REDIS_PASSWORD=123

# RabbitMQ 配置
# 账号/vhost 由 docker/init/rabbitmq/definitions.json 硬编码（litisle / litisle_pass / /litisle），
# compose 不再用 RABBITMQ_DEFAULT_* 环境变量，此处仅作应用侧连接参考：
#   host: localhost / port: 5672 / vhost: /litisle / user: litisle / pass: litisle_pass

# Nacos 鉴权配置
NACOS_AUTH_KEY=serverIdentity
NACOS_AUTH_VALUE=security
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789