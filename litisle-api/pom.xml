<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 父模块 -->
    <parent>
        <groupId>com.litisle</groupId>
        <artifactId>Litisle</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 基本信息 -->
    <groupId>com.litisle</groupId>
    <artifactId>litisle-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>litisle-api</name>
    <description>API 契约模块（DTO / Feign Client）</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>

        <!-- ✅ Lombok（编译期） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ✅ Bean Validation（接口约束） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

<!--        &lt;!&ndash; ✅ Spring Cloud OpenFeign（仅契约，不启动） &ndash;&gt;-->
<!--        <dependency>-->
<!--            <groupId>org.springframework.cloud</groupId>-->
<!--            <artifactId>spring-cloud-openfeign-core</artifactId>-->
<!--        </dependency>-->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ✅ Spring Boot 自动配置（FeignFallbackAutoConfiguration 的 @ConditionalOn* 注解） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ✅ Spring Web（@RequestMapping / @RestController） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- ✅ MyBatis-Plus 注解（仅 @EnumValue 入库映射标记，AiPurposeEnum.code 使用）；
             契约模块不引 starter，运行期由各服务模块的 mybatis-plus-spring-boot3-starter 提供实现，
             故 scope=provided；版本沿用父 pom 的 ${mybatis-plus.version} -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
            <version>${mybatis-plus.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ✅ opencc4j（批次2 ③：CharNormalizer 繁简归一，与 houbb ignoreChineseStyle 同源引擎；
             批次3 删 houbb 后独立承载繁简转换） -->
        <dependency>
            <groupId>com.github.houbb</groupId>
            <artifactId>opencc4j</artifactId>
        </dependency>

        <!-- ✅ heaven（opencc4j 的运行期依赖，必须显式声明）
             opencc4j 内部 ZhConverterUtil 静态初始化会调用 Instances.singleton，
             该能力在 heaven 中，但 opencc4j 只在自身 POM 里以传递依赖形式带入；
             传递依赖的作用域会被下游模块更近的同名依赖压成 test（review 的 sensitive-word 即如此），
             结果运行期缺少 com.github.houbb.heaven.support.instance.impl.Instances。
             这里在 litisle-api 直接声明 compile，保证使用 DFA/CharNormalizer 的服务
             在 IDE 直跑与打包 jar 时都能加载到该类。
             版本取 0.13.0：与 sensitive-word 0.27.1 依赖的版本一致，避免同 GA 双版本；
             已核对 opencc4j 1.8.1 引用的 9 个 heaven 类在 0.13.0 中全部存在且签名兼容。 -->
        <dependency>
            <groupId>com.github.houbb</groupId>
            <artifactId>heaven</artifactId>
            <version>0.13.0</version>
        </dependency>

        <!-- ✅ hankcs ACDAT（DFA 引擎切换批次1：AhoCorasickDoubleArrayTrie 双数组 trie 匹配内核，
             严格 O(文本长度)，官方基准英文 5 倍 / 中文 9 倍于朴素 trie + fail 指针实现；
             Maven Central 直引，零传递依赖。批次2 工厂接线、批次3 删旧引擎 AcTextScanEngine
             后成为唯一内核） -->
        <dependency>
            <groupId>com.hankcs</groupId>
            <artifactId>aho-corasick-double-array-trie</artifactId>
            <version>1.2.3</version>
        </dependency>

        <!-- common 模块 -->
        <!-- ✅ Jackson（JSON 序列化） com.fasterxml.jackson.core-->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ✅ 测试（可选，非必须） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- ✅ 仅保留编译器插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>