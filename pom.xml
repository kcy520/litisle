<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.litisle</groupId>
    <artifactId>LitIsle</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>LitIsle</name>
    <description>LitIsle</description>


    <modules>
        <module>litisle-auth</module>
        <module>litisle-common</module>
        <module>litisle-content</module>
        <module>litisle-gateway</module>
        <module>litisle-payment</module>
        <module>litisle-search</module>
        <module>litisle-social</module>
        <module>litisle-user</module>
        <module>litisle-ai</module>
        <module>litisle-api</module>
    </modules>

    <properties>
        <java.version>25</java.version>
    </properties>


    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
