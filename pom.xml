<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.litisle</groupId>
    <artifactId>Litisle</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>LitIsle</name>
    <description>LitIsle</description>

    <!-- 关键：声明为 pom 打包类型 -->
    <packaging>pom</packaging>

    <modules>
        <module>litisle-auth</module>
        <module>litisle-common</module>
        <module>litisle-content</module>
        <module>litisle-gateway</module>
        <module>litisle-payment</module>
        <module>litisle-search</module>
        <module>litisle-social</module>
        <module>litisle-user</module>
        <module>litisle-ai</module>
        <module>litisle-api</module>
        <module>litisle-review</module>
        <module>litisle-file</module>
        <module>litisle-notification</module>
        <module>litisle-shop</module>
    </modules>

    <properties>

        <!-- 基础  -->
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--  Spring  -->
        <spring-boot.version>3.5.15</spring-boot.version>
        <!-- Spring Boot 3.5.x ↔ Spring Cloud 2025.0.x (Northfields) -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- Spring Cloud Alibaba 2025.0.0.0 ↔ Spring Cloud 2025.0.x ↔ Boot 3.5.x -->
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>

        <!--  中间件  -->
        <!-- MyBatis-Plus Boot3 Starter（必须用它，不能用旧版） -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <!-- MySQL Connector/J 8.3+ 或 8.4 均兼容 Boot 3 + JDK 25 -->
        <mysql.version>8.0.33</mysql.version>
        <hutool.version>5.8.20</hutool.version>
        <elasticsearch.version>8.18.8</elasticsearch.version>


        <!-- ========== 工具 ========== -->
        <sa-token.version>1.45.0</sa-token.version>

        <org.projectlombok.version>1.18.38</org.projectlombok.version>

        <!--其他后续添加-->
        <!--knife4j：4.5.0（内含 springdoc 2.2.x）。注意 springdoc 2.2.x 与 Spring 6.2 存在惰性不兼容：
             扫描 @RestControllerAdvice 类时会因 ControllerAdviceBean 构造器被移除抛 NoSuchMethodError，
             项目内所有 @RestControllerAdvice 类必须添加 @Hidden 排除扫描（GlobalExceptionHandler、SaTokenExceptionHandler） -->
        <knife4j>4.5.0</knife4j>
        <!--redission-->
        <redisson.version>3.52.0</redisson.version>
        <!-- JJWT -->
        <jjwt.version>0.12.6</jjwt.version>

        <!-- Jackson 版本锁定（与 Boot 3.5.15 托管版本一致） -->
        <!-- 显式导入 jackson-bom，避免被 spring-cloud / spring-cloud-alibaba BOM 干扰 -->
        <jackson-bom.version>2.21.4</jackson-bom.version>

        <!-- AWS SDK v2（litisle-file 对接 SeaweedFS S3 网关） -->
        <aws-sdk.version>2.32.6</aws-sdk.version>

        <!-- 中文繁简转换（批次2 ③：CharNormalizer 繁简归一口径，与 houbb ignoreChineseStyle 同源引擎；
             批次3 删 houbb 后本依赖独立承载繁简转换） -->
        <opencc4j.version>1.8.1</opencc4j.version>
        <!-- ONNX Runtime（litisle-review 本地鉴黄，JDK 25 兼容） -->
        <onnxruntime.version>1.20.0</onnxruntime.version>

        <!-- LangChain4j（AI 模块 Agent 化底座：P2 定档 2026-11-15，DeepSeek API 走 OpenAI 兼容通道 + AiServices 装配；
             官方 BOM 统一管理 langchain4j-open-ai 等模块版本） -->
        <langchain4j.version>1.23.0</langchain4j.version>

    </properties>



    <!-- 对依赖包进行管理 -->
    <dependencyManagement>
        <dependencies>
            <!--spring cloud-->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--spring cloud alibaba-->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--Jackson BOM：全工程统一 Jackson 版本（含 databind/core/annotations/datatype）-->
            <!-- 为什么版本写 2.21.4 这是 Spring Boot 3.5.15 官方托管的 jackson-databind 版本，与父 POM 的默认值保持一致——导入 jackson-bom 的目的不是「升级」，而是「显式锁定」，让版本不受其他 BOM 导入顺序、本地缓存的影响。将来升级 Boot 时只需同步改这一个属性。 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--API 文档  增强的 Swagger UI 界面-->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j}</version>
            </dependency>

            <!-- 数据库驱动包管理 -->
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <!-- mybatis plus 管理 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--hutool工具包-->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!--Elasticsearch Java Client（由 Spring Boot 管理版本，与 Spring Data Elasticsearch 兼容）-->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>

            <!-- 阿里云内容安全 V2.0 SDK（review 板块十：文本机审云 API 主通道，TextModeration 同步接口） -->
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>green20220302</artifactId>
                <version>3.6.10</version>
            </dependency>

            <!--redission-->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- Hutool 工具包 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- AWS SDK BOM：统一管理 s3/regions/auth 等模块版本 -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 中文繁简转换（批次2 ③ CharNormalizer：与 houbb ignoreChineseStyle 同源口径） -->
            <dependency>
                <groupId>com.github.houbb</groupId>
                <artifactId>opencc4j</artifactId>
                <version>${opencc4j.version}</version>
            </dependency>
            <!-- ONNX Runtime（litisle-review 本地鉴黄） -->
            <dependency>
                <groupId>com.microsoft.onnxruntime</groupId>
                <artifactId>onnxruntime</artifactId>
                <version>${onnxruntime.version}</version>
            </dependency>

            <!-- LangChain4j BOM：统一管理 langchain4j-open-ai / AiServices 等模块版本（AI 模块） -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>



<!--            &lt;!&ndash; JJWT（JWT 令牌签发与验证） &ndash;&gt;-->
<!--            <dependency>-->
<!--                <groupId>io.jsonwebtoken</groupId>-->
<!--                <artifactId>jjwt-api</artifactId>-->
<!--                <version>${jjwt.version}</version>-->
<!--            </dependency>-->
<!--            <dependency>-->
<!--                <groupId>io.jsonwebtoken</groupId>-->
<!--                <artifactId>jjwt-impl</artifactId>-->
<!--                <version>${jjwt.version}</version>-->
<!--                <scope>runtime</scope>-->
<!--            </dependency>-->
<!--            <dependency>-->
<!--                <groupId>io.jsonwebtoken</groupId>-->
<!--                <artifactId>jjwt-jackson</artifactId>-->
<!--                <version>${jjwt.version}</version>-->
<!--                <scope>runtime</scope>-->
<!--            </dependency>-->

        </dependencies>
    </dependencyManagement>



    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 统一管理的 Spring Boot Maven 插件（子模块按需引用，不用自己写版本） -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>