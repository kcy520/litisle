<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.litisle</groupId>
        <artifactId>litisle-common</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common-mq</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>common-mq</name>
    <description>common-mq</description>
    <properties>
        <java.version>25</java.version>
    </properties>


    <dependencies>
        <!-- common-core：HeaderConstant（MQ 链路 traceId Header 名与 Feign/HTTP 同一口径）、JsonUtil -->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-core</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- spring-boot-starter-amqp：RabbitTemplate / @RabbitListener / 拓扑声明（Exchange/Queue/Binding） -->
        <!-- 版本由 Spring Boot 3.5.x 父 POM 管理，无需指定版本 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- jackson-databind：Jackson2JsonMessageConverter 事件体 JSON 序列化（项目纪律：禁 Java 原生反序列化） -->
        <!-- 【重要】compile：common-mq 代码直接引用 Jackson 类，且 common-core 的 jackson-databind 为 provided（不传递），
             必须在此显式引入；版本由根 POM jackson-bom 统一锁定 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- spring-boot-starter-data-redis：MqIdempotentHelper 幂等去重（SETNX）依赖的 StringRedisTemplate -->
        <!-- 【重要】provided：仅编译期可用、不传递——未接 Redis 的消费方引 common-mq 不受影响
             （对齐 micrometer-core provided 模式）；业务服务自行引入 redis starter 后自动生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- micrometer-core：MqMetrics 收发指标埋点（mq_send_total / mq_consume_total） -->
        <!-- 【重要】provided：仅编译期可用、不传递——未接 Micrometer 的消费方引 common-mq 不受影响
             （照搬 RedisGuard 模式）；业务服务自行引入 actuator/prometheus 后自动生效 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- JDK 21+ 动态 agent 加载废弃警告治理（Mockito 官方文档标准方案）：
         ① maven-dependency-plugin 的 properties goal 在 initialize 阶段把所有依赖（含传递依赖）的
         ${groupId:artifactId:type} 坐标属性注册进 Maven 属性表——仅靠直接依赖声明的内置属性
         在部分 Maven 版本上不生效（已踩坑：占位符原样传给 JVM 致 forked VM 崩溃）；
         ② surefire argLine 用该属性静态挂载 mockito-core agent，Mockito 检测到 agent 已就位
         即不再运行时自挂载，废弃警告消失；版本仍由 Spring Boot 父 POM 托管，无硬编码 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
