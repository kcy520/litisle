<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--父模块-->
    <parent>
        <groupId>com.litisle</groupId>
        <artifactId>Litisle</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--一些基本描述-->
    <groupId>com.litisle</groupId>
    <artifactId>litisle-review</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>litisle-review</name>
    <description>litisle-review</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <!--dependencies部分-->
    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Web MVC：机审/人审/申诉/举报 REST 接口 + Jackson 序列化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（申诉/举报/裁决等入参校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- RabbitMQ：moderation.exchange 异步机审 + x-delay 退避重试 + DLX 兜底 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- 阿里云内容安全 SDK（板块十 10.1：text-provider=aliyun 文本机审主通道；
             版本由父 POM dependencyManagement 锁定，AK/SK 经 Nacos/环境变量注入禁提交明文） -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>green20220302</artifactId>
        </dependency>

        <!-- Actuator 监控端点：暴露 /actuator/prometheus（moderation_total/backlog 等指标） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Prometheus 指标注册表：提供 /actuator/prometheus 端点（actuator 本体不含） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- common-core：Result / BizException / ErrorCode / DictEnum -->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- common-redis：Redisson 锁（去重短锁/词库热更）+ @Idempotent/@RateLimiter + RedisTemplate -->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- common-security：Sa-Token 鉴权 + 角色校验 + @AuditLog 审计 + UGC XSS 过滤 -->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MyBatis-Plus：ReviewTaskMapper/ReportMapper 等 extends BaseMapper（yml 已配置） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MySQL 驱动（litisle_review 库） -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <!-- Redis 连接池（yml lettuce pool 配置的前提） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- houbb sensitive-word（批次3 ⑤b：生产依赖已删除，；
             仅保留 test scope，供影子比对回归 WordlibEngineShadowCompareTest 与语义探针 HoubbRepeatProbeTest 使用） -->
        <dependency>
            <groupId>com.github.houbb</groupId>
            <artifactId>sensitive-word</artifactId>
            <!-- 版本显式声明（dependencyManagement 条目已随批次3 ⑤b 删除，仅测试引用） -->
            <version>0.27.1</version>
            <scope>test</scope> <!--注意，是test-->
            <exclusions>
                <!-- 排除 sensitive-word 传递带入的 houbb 三件套（heaven/opencc4j/nlp-common）：
                     它们在此处是 test 作用域，且 heaven 距离更近，会把 litisle-api 中
                     opencc4j 需要的 heaven 顶成 test 作用域，导致 review 主程序运行期
                     缺 com.github.houbb.heaven.support.instance.impl.Instances（DFA 初始化炸）。
                     运行期与测试所需的这三个包统一由 litisle-api 的 compile 依赖提供，版本一致。 -->
                <exclusion>
                    <groupId>com.github.houbb</groupId>
                    <artifactId>heaven</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.houbb</groupId>
                    <artifactId>opencc4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.houbb</groupId>
                    <artifactId>nlp-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ONNX 本地鉴黄（开发期 image-provider=onnx，CPU 推理；版本由父 POM 托管） -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
        </dependency>

        <!-- Feign：回查 ContentClient/FileClient/MessageClient（fallbackFactory fail-fast） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign 负载均衡 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Sentinel：Feign fallbackFactory 生效前提（feign.sentinel.enabled: true） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- Sentinel 规则 Nacos 数据源：dataId=litisle-review-degrade-rules.json（见 application-local.yaml） -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>

        <!-- Nacos 服务注册发现（被网关 lb://litisle-review 路由的前提） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心（拉取 litisle-shared.yaml 共享配置） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- api 模块：Feign 接口定义（ContentClient/FileClient/MessageClient）与公共 DTO -->
        <!--Ac自动机的 hankcs 依赖放入了api模块-->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>litisle-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <!-- API 文档（yml knife4j 段已配置，扫 controller 包） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!--lombok-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-mq</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven 插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven 编译器插件（Lombok 注解处理器） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>

                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>