<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--父模块-->
    <parent>
        <groupId>com.litisle</groupId>
        <artifactId>Litisle</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--一些基本描述-->
    <groupId>com.litisle</groupId>
    <artifactId>litisle-ai</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>litisle-ai</name>
    <description>litisle-ai</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <!--dependencies部分-->
    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Web MVC：AI REST 接入层（小悦端点 / 内部 Feign 提供方端点）+ Jackson 序列化（板块零骨架，业务随板块一/二落地） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Feign：消费方客户端（板块二经 ContentClient 回查稿件/标签池；契约 AiClient 在 litisle-api，由调用方 review 使用） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign 负载均衡（Nacos 服务名 lb:// 路由的前提） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- MyBatis-Plus：ai_token_usage / ai_session / ai_message 等 Mapper extends BaseMapper（表已建：docker/init/mysql/schema/ai-schema.sql） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MySQL 驱动（litisle_ai 库） -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <!-- Redis：配额日计数 / 预算本地缓存键 / 建议 TTL 缓存 / ChatMemoryStore（板块一/三落地） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Redis 连接池（yml lettuce pool 配置的前提） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- RabbitMQ：消费 content.published / content.unpublished 做 RAG 知识库摄入（板块四落地；骨架仅接连接配置） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Actuator 监控端点：暴露 /actuator/prometheus（ai_call_total / ai_call_latency 等指标，板块一 1.5） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标注册表：提供 /actuator/prometheus 端点（actuator 本体不含） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- LangChain4j OpenAI 官方模块：OpenAI 兼容通道 SDK（P2 定档：DeepSeek API 国内直连；
             base-url/api-key/model/超时/重试全部外置 yml/Nacos，provider 层是唯一接触模型 SDK 的地方） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>

        <!-- LangChain4j 主模块：AiServices 装配小悦 ChatAgent + @Tool Function Calling（板块二 2.1，版本由父 POM langchain4j-bom 管理） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- common-mq：MQ 机制层统一收口（Jackson2JsonMessageConverter / MqSendUtil / MqAckHelper / MqTraceSupport，
             板块四 4.1 RagIngestConsumer 消费模板与延迟重投复用） -->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-mq</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- common-security：Sa-Token 登录态（用户身份只从会话取，禁止客户端传 userId；
             UserIdResolver 未登录返回 null，供匿名问答/匿名相似推荐使用） -->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- LangChain4j Ollama 模块：本地 Ollama embedding 客户端（P3 定档：bge-m3 1024 维，零外发零成本） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
        </dependency>

        <!-- Elasticsearch Java 客户端：article_chunks 向量索引读写（板块四 4.1/P9：AI 自建自管，索引名隔离；
             版本由父 POM dependencyManagement 管理，与 search 同坐标） -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>

        <!-- Nacos 服务注册发现（网关 / 其他服务经 lb://litisle-ai 调用的前提） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心（拉取 litisle-ai.yaml 与 litisle-shared.yaml 共享配置） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- api 模块：AiClient 契约与 dto/ai 公共 DTO（AiPurposeEnum / AiChatRequestDTO，板块一 1.2）；
             @EnableFeignClients 随板块二 ContentClient 接线时再开（AI 自身不消费 Feign 客户端，避免自注册 AiClient） -->
        <dependency>
            <groupId>com.litisle</groupId>
            <artifactId>litisle-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <!--lombok-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven 插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven 编译器插件（Lombok 注解处理器） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>

                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>